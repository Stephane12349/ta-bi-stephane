rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FONCTIONS D'AIDE & SÉCURITÉ AUTHENTIFICATION
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Récupérer le document de profil de l'utilisateur connecté
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token.role == role) ||
        (getUserData().role == role)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == 'ADMIN') ||
        (getUserData().role == 'ADMIN')
      );
    }

    function isWholesaler() {
      return isAuthenticated() && (
        (request.auth.token.role == 'WHOLESALER') ||
        (getUserData().role == 'WHOLESALER')
      );
    }

    function isBuyer() {
      return isAuthenticated() && (
        (request.auth.token.role == 'BUYER') ||
        (getUserData().role == 'BUYER')
      );
    }

    // Vérifier si la boutique appartient au grossiste connecté
    function isShopOwner(shopId) {
      return isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid
      );
    }

    // =========================================================================
    // 1. COLLECTION : USERS (Profils Utilisateurs)
    // =========================================================================
    match /users/{userId} {
      // Lecture : l'utilisateur lui-même, ou un administrateur
      allow read: if isOwner(userId) || isAdmin();

      // Création : l'utilisateur lui-même lors du premier login, sans pouvoir s'attribuer le rôle ADMIN
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.role in ['BUYER', 'WHOLESALER']
      ) && request.resource.data.phone != null;

      // Modification : l'utilisateur lui-même pour ses infos, mais interdiction formelle de modifier son rôle ou son statut de vérification
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified', 'createdAt'])
      ) || isAdmin();

      // Suppression : Administrateur uniquement (suppression logique recommandée)
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. COLLECTION : SHOPS (Boutiques Grossistes)
    // =========================================================================
    match/shops/{shopId} {
      // Lecture publique : Tout utilisateur peut consulter les vitrines marchandes
      allow read: if true;

      // Création : Un grossiste authentifié peut créer sa boutique
      allow create: if isWholesaler() && 
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.isVerified == false; // La certification ne peut être donnée que par l'Admin

      // Modification : Le propriétaire peut mettre à jour ses horaires/repères, mais pas son badge de vérification ni sa note
      allow update: if (isShopOwner(shopId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'verificationBadge', 'rating', 'reviewCount', 'ownerId']))
                    || isAdmin();

      // Suppression : Propriétaire ou Admin
      allow delete: if isShopOwner(shopId) || isAdmin();
    }

    // =========================================================================
    // 3. COLLECTION : PRODUCTS (Articles de Gros & Paliers)
    // =========================================================================
    match /products/{productId} {
      // Lecture publique : Tout le monde peut explorer le catalogue
      allow read: if true;

      // Création : Seul le grossiste propriétaire de la boutique concernée
      allow create: if isWholesaler() && 
                    isShopOwner(request.resource.data.shopId) &&
                    request.resource.data.minOrderQuantity >= 1 &&
                    request.resource.data.basePrice > 0;

      // Modification : Le propriétaire de la boutique uniquement
      allow update: if (isWholesaler() && isShopOwner(resource.data.shopId)) || isAdmin();

      // Suppression : Le propriétaire ou l'Admin
      allow delete: if (isWholesaler() && isShopOwner(resource.data.shopId)) || isAdmin();
    }

    // =========================================================================
    // 4. COLLECTION : CATEGORIES (Filières Marchandes)
    // =========================================================================
    match /categories/{categoryId} {
      // Lecture publique
      allow read: if true;

      // Seul l'administrateur peut créer, modifier ou supprimer des filières
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. COLLECTION : ORDERS (Commandes & Réservations B2B)
    // =========================================================================
    match /orders/{orderId} {
      // Lecture : L'acheteur de la commande, le grossiste vendeur, ou l'administrateur
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isShopOwner(resource.data.shopId) ||
        isAdmin()
      );

      // Création : L'acheteur authentifié peut passer commande, statut initial obligatoirement PENDING
      allow create: if isBuyer() && 
                    request.resource.data.buyerId == request.auth.uid &&
                    request.resource.data.status == 'PENDING' &&
                    request.resource.data.totalAmount > 0 &&
                    request.resource.data.pickupPinCode != null;

      // Modification : 
      // - L'acheteur peut annuler sa commande tant qu'elle est PENDING
      // - Le grossiste peut faire évoluer les statuts (CONFIRMED, PREPARING, READY, COMPLETED, REJECTED)
      // - L'Admin a un droit de médiation
      allow update: if isAuthenticated() && (
        (resource.data.buyerId == request.auth.uid && 
         request.resource.data.status in ['CANCELLED'] && 
         resource.data.status == 'PENDING') ||
        (resource.data.sellerId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'notes'])) ||
        isAdmin()
      );

      // Interdiction de supprimer une commande pour conserver l'historique comptable et d'audit
      allow delete: if false;
    }

    // =========================================================================
    // 6. COLLECTION : CONVERSATIONS & MESSAGES (Messagerie In-App)
    // =========================================================================
    match /conversations/{conversationId} {
      // Lecture & Écriture : Uniquement les participants enregistrés
      allow read, update: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds ||
        isAdmin()
      );

      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds ||
          isAdmin()
        );

        allow create: if isAuthenticated() && 
                      request.resource.data.senderId == request.auth.uid &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow update: if isAuthenticated() && (
          // Seule la mise à jour du statut "isRead" est autorisée
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        );

        allow delete: if isAdmin();
      }
    }

    // =========================================================================
    // 7. COLLECTION : REVIEWS (Avis & Notations Vérifiées)
    // =========================================================================
    match /reviews/{reviewId} {
      // Lecture publique des avis
      allow read: if true;

      // Création : Un acheteur peut publier un avis SI ET SEULEMENT S'il a conclu une commande COMPLETED auprès de ce grossiste
      allow create: if isBuyer() && 
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                    request.resource.data.orderId != null;

      // Modification / Suppression : L'auteur ou l'Admin
      allow update, delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // =========================================================================
    // 8. COLLECTION : FAVORITES (Carnet de Grossistes & Articles Sauvegardés)
    // =========================================================================
    match /favorites/{favoriteId} {
      allow read, write: if isOwner(resource.data.userId) || 
                         (request.resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 9. COLLECTION : NOTIFICATIONS (Alertes Utilisateur)
    // =========================================================================
    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.recipientId);
      // Seules les Cloud Functions / Admin créent des notifications système
      allow create, delete: if isAdmin();
    }

    // =========================================================================
    // 10. COLLECTION : VERIFICATION_REQUESTS (KYC Audit Terrain Grossiste)
    // =========================================================================
    match /verificationRequests/{requestId} {
      // Le grossiste peut voir sa propre demande, l'Admin voit tout
      allow read: if isOwner(resource.data.wholesalerId) || isAdmin();

      // Soumission initiale par le grossiste
      allow create: if isWholesaler() && 
                    request.resource.data.wholesalerId == request.auth.uid &&
                    request.resource.data.status == 'REQUESTED';

      // Modification de statut (UNDER_REVIEW, VERIFIED, REJECTED) : Administrateur uniquement
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 11. COLLECTION : REPORTS (Signalements de Litiges & Fraudes)
    // =========================================================================
    match /reports/{reportId} {
      // L'auteur peut lire son signalement, l'Admin instruit le dossier
      allow read: if isOwner(resource.data.reporterId) || isAdmin();

      // Tout utilisateur connecté peut signaler une boutique ou un produit
      allow create: if isAuthenticated() && 
                    request.resource.data.reporterId == request.auth.uid &&
                    request.resource.data.status == 'PENDING';

      // Seul l'administrateur peut changer le statut du litige (RESOLVED, DISMISSED)
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 12. COLLECTION : AUDIT_LOGS (Journal des Actions Administratives)
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Créé exclusivement par Cloud Functions sécurisées
    }

    // =========================================================================
    // 13. COLLECTION : SEARCHES & ANALYTICS
    // =========================================================================
    match /searches/{searchId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
